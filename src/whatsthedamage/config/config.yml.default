text_cleaning:
  payment_providers:
    - "^OTPMOBL\\s*"
    - "^PAYPAL\\s*"
    - "^CRV\\s*"
    - "^SUMUP\\s*"
    - "^BARION(P)*\\s*"
    - "^VIMPAY\\s*"
    - "^SIMPLEP\\s*"
    - "^FESTIPAY\\s*"
    - "^GOPAY\\s*"
    - "^HELOPAY\\s*"
    - "^HUF\\s*"
  company_suffixes:
    - "\\s+(?:[Kk]ft|[Zz]rt|[Rr]t|[Nn]yrt)\\.*\\b"
    - "\\s*(es\\s+)?tarsasag\\s*$"
    - "\\s*korlatolt\\s+felelossegu\\s*$"
    - "\\s*kisker\\s*$"
    - "\\s*szolgaltato\\s*$"
    - "\\s*kereskedelmi\\s*$"
    - "\\s+u\\.\\s*$"
    - "\\s*utca\\s*$"
    - "\\s+ut\\s*$"
    - "\\s*&\\s*$"
  buggy_partner_replacements:
    "e lelmisz": "Élelmisz"
    "e ttere": "Éttere"
    "CUKRA SZDA": "Cukrászda"
    "vende glo": "Vendeglő"
    "VENDE GL": "Vendégl"
    "vira g": "virág"
    "szo lo s": "szőlős"
    "ve rtes": "Vértes"
